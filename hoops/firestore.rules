rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function teamDoc(t) { return get(/databases/$(db)/documents/teams/$(t)).data; }
    function isMember(t) { return signedIn() && request.auth.uid in teamDoc(t).memberIds; }
    function isCoach(t) { return signedIn() && teamDoc(t).coachUid == request.auth.uid; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes: anyone signed in can look one up; only the team's coach can create it.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && getAfter(/databases/$(db)/documents/teams/$(request.resource.data.teamId)).data.coachUid == request.auth.uid;
    }

    match /teams/{t} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function onlyMembership() {
        return after().diff(before()).affectedKeys().hasOnly(['memberIds', 'members'])
          && after().members.diff(before().members).affectedKeys().hasOnly([request.auth.uid]);
      }
      function selfJoin() {
        return onlyMembership()
          && after().memberIds.toSet().difference(before().memberIds.toSet()) == [request.auth.uid].toSet()
          && before().memberIds.toSet().difference(after().memberIds.toSet()).size() == 0
          && after().members[request.auth.uid].role == 'player';
      }
      function selfLeave() {
        return onlyMembership()
          && request.auth.uid != before().coachUid
          && before().memberIds.toSet().difference(after().memberIds.toSet()) == [request.auth.uid].toSet()
          && after().memberIds.toSet().difference(before().memberIds.toSet()).size() == 0;
      }
      function coachEdit() {
        return before().coachUid == request.auth.uid && after().coachUid == before().coachUid;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && after().coachUid == request.auth.uid && after().memberIds == [request.auth.uid];
      allow update: if signedIn() && (coachEdit() || selfJoin() || selfLeave());
      allow delete: if signedIn() && before().coachUid == request.auth.uid;

      // Team plays: everyone on the team can watch, only the coach edits.
      match /plays/{p} {
        allow read: if isMember(t);
        allow write: if isCoach(t);
      }

      // Player versions: players see and edit their own, the coach sees all and leaves feedback.
      match /versions/{v} {
        allow read: if isCoach(t) || (isMember(t) && resource.data.authorUid == request.auth.uid);
        allow create: if isMember(t) && request.resource.data.authorUid == request.auth.uid;
        allow update: if (isMember(t)
              && resource.data.authorUid == request.auth.uid
              && request.resource.data.authorUid == request.auth.uid
              && request.resource.data.feedback == resource.data.feedback)
          || (isCoach(t)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'status', 'reviewedAt']));
        allow delete: if isMember(t) && resource.data.authorUid == request.auth.uid;
      }
    }
  }
}
