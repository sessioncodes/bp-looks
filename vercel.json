{
  "redirects": [
    { "source": "/hoops", "destination": "/hoops/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "/api/fb-auth?p=:path*" }
  ],
  "headers": [
    {
      "source": "/hoops/(sw.js|index.html|app.js|cloud.js|styles.css|firebase-config.js|manifest.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/hoops/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
